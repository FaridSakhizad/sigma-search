{
  "name": "Sigma Search",
  "description": "Find text on web pages with control over case, whole words and keyboard navigation. Optional regular expressions.",
  "version": "0.1.0",
  "manifest_version": 3,
  "action": {
    "default_title": "Sigma Search",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "64": "assets/icons/icon64.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "64": "assets/icons/icon64.png",
    "128": "assets/icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["src/content/*.js", "src/shared/*.js"],
      "matches": ["https://*/*", "http://*/*"]
    }
  ],
  "permissions": ["activeTab", "scripting", "storage", "offscreen"],
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Open Sigma Search"
    },
    "next-result": {
      "suggested_key": {
        "default": "Alt+Shift+N"
      },
      "description": "Next search result"
    },
    "previous-result": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Previous search result"
    }
  },
  "version_name": "0.1.0 beta"
}
